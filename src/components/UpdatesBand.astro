---
import EmailCapture from './EmailCapture.astro';
---
<section class="updates" id="updates">
  <div class="container">
    <div class="inner">
      <p class="eyebrow">Product updates</p>
      <div class="copy">
        <h2>Not on iPhone, or outside the US?</h2>
        <p class="lead">
          Pillot is on the App Store for iPhone in the United States. If that’s not you yet,
          leave your email and we’ll let you know as it reaches more phones and places.
        </p>
      </div>
      <div class="signup">
        <EmailCapture
          label=""
          success="You’re on the list. Check your inbox to confirm, and we’ll email you with Pillot news."
        />
      </div>
    </div>
  </div>
</section>

<style>
  .updates {
    margin-top: 72px;
  }

  /* Full container width, like every other band. The reading measure belongs on
     the copy, not the whole section, or the rule and form shrink with it. */
  /* Full container width, like every other band. The reading measure belongs on
     the copy, not the whole section, or the rule and form shrink with it.
     The eyebrow gets its own row so the headline and the form start on the same
     one and align at the top without a hand-tuned offset. */
  .inner {
    border-top: 1px solid var(--hairline);
    padding-top: 40px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 48px;
    align-items: start;
  }

  .eyebrow {
    grid-column: 1 / -1;
  }

  .copy {
    grid-column: 1;
    max-width: 46ch;
  }

  .signup {
    grid-column: 2;
  }

  /* Stack once the two columns stop fitting, with the form sharing the copy's
     edge instead of ending short of it. */
  @media (max-width: 760px) {
    .inner {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 24px;
    }

    .signup {
      grid-column: 1;
      width: 100%;
    }
  }

  .eyebrow {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 10px;
  }

  h2 {
    font-family: var(--font-serif);
    font-size: 22px;
    font-weight: 500;
    margin-bottom: 8px;
  }

  .lead {
    font-size: 15px;
    color: var(--body);
    margin-bottom: 18px;
  }
</style>
